generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String?
  image               String?
  username            String               @unique
  isPublicAccount     Boolean              @default(true)
  biography           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  countriesMemories   UserCountry[]
  itinerary           Itinerary[]
  passwordResetTokens PasswordResetToken[]
  savedDestinations   SavedDestinations[]
  savedReadyGuides    SavedReadyGuides[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Itinerary {
  id                        String   @id @default(uuid())
  userId                    String
  departure                 String
  destination               String
  startDate                 String
  endDate                   String
  countryOrigin             String
  countryDestination        String
  countryOriginFlagURL      String
  countryDestinationFlagURL String
  travelType                String
  currency                  String
  days                      Int
  travelers                 Int
  budgetTotal               Float
  itinerary                 Json
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadyGuides {
  id                String             @id @default(uuid())
  imageURL          String
  title             String
  description       String
  travelType        String
  continent         String
  bestTime          String
  language          String
  currenty          String
  overviewResume    String
  cities            String[]
  days              Int
  price             Float
  overview          Json
  itinerary         Json
  accommodations    Json
  usefulInformation Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  savedReadyGuides  SavedReadyGuides[]
}

model Destinations {
  id                String              @id @default(uuid())
  imageURL          String
  bannerURL         String
  destination       String
  description       String
  country           String
  travelType        String
  continent         String
  bestTime          String
  language          String
  currenty          String
  weather           String
  dayReccomended    Int
  usefulInformation Json
  whatToDo          Json
  attractions       Json
  averageCost       Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  savedDestinations SavedDestinations[]
}

model SavedDestinations {
  id            String       @id @default(uuid())
  userId        String
  destinationId String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  destination   Destinations @relation(fields: [destinationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@unique([userId, destinationId])
}

model SavedReadyGuides {
  id           String      @id @default(uuid())
  userId       String
  readyGuideId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  readyGuide   ReadyGuides @relation(fields: [readyGuideId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@unique([userId, readyGuideId])
}

model UserCountry {
  id                String            @id @default(uuid())
  userId            String
  countryCode       String
  countryName       String
  isVisitedCountry  Boolean           @default(false)
  isWishListCountry Boolean           @default(false)
  visitedAt         String?
  notes             String?           @db.VarChar(500)
  cities            UserCountryCity[]
  memories          CountryMemory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([countryCode])
}

model UserCountryCity {
  id            String @id @default(uuid())
  userCountryId String
  name          String

  userCountry UserCountry @relation(fields: [userCountryId], references: [id], onDelete: Cascade)

  @@unique([userCountryId, name])
}

model CountryMemory {
  id            String   @id @default(uuid())
  userCountryId String
  title         String?
  description   String?  @db.VarChar(500)
  imageURL      String
  createdAt     DateTime @default(now())

  userCountry UserCountry @relation(fields: [userCountryId], references: [id], onDelete: Cascade)
}
